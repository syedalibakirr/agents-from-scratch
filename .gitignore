# Traces contain content from whatever repo you point the agent at — never commit them
traces.jsonl
*.jsonl
# ...except this one sample, kept to show the trace format
!build-04/traces.jsonl

# Scrubbed traces: tool routes and answers only, no file contents
!traces_public/
!traces_public/*.public.json

